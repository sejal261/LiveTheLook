# Flask Security
SECRET_KEY=dev-secret-key-change-in-production

# Database (PostgreSQL for Render production, SQLite default for local development)
DATABASE_URL=sqlite:///interior_design.db

# Admin Credentials (Used by seed script init_db.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# Cloudinary Storage Credentials (Optional in local dev, required for Render production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External AI Chatbot API (Optional: Gemini API key for advanced AI responses)
GEMINI_API_KEY=
