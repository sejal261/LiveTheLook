<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Shop Room Looks — Direct Product Links & Decor Ideas' %></title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/static/css/main.css">
    <% if (typeof extra_css !== 'undefined' && extra_css) { %>
        <link rel="stylesheet" href="<%= extra_css %>">
    <% } %>
</head>
<body>

    <!-- Header Navigation -->
    <header class="site-header">
        <div class="nav-container">
            <a href="/" class="brand-logo">
                <i class="fa-solid fa-couch"></i> InteriorCraft
            </a>

            <ul class="nav-links">
                <li><a href="/" class="nav-link <%= current_path === '/' ? 'active' : '' %>">Home</a></li>
                <li><a href="/explore" class="nav-link <%= current_path.startsWith('/explore') ? 'active' : '' %>">Shop Room Looks</a></li>
                <% if (typeof all_categories !== 'undefined') { %>
                    <% all_categories.slice(0, 4).forEach(function(cat) { %>
                        <li><a href="/explore?category=<%= cat.slug %>" class="nav-link"><%= cat.name %></a></li>
                    <% }); %>
                <% } %>
            </ul>

            <div class="nav-actions">
                <button class="btn btn-outline btn-sm" onclick="toggleChatbot()">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> AI Assistant
                </button>

                <% if (typeof current_user !== 'undefined' && current_user) { %>
                <a href="/admin" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-gauge"></i> Admin Dashboard
                </a>
                <% } else { %>
                <a href="/admin/login" class="btn btn-outline btn-sm" title="Admin Login">
                    <i class="fa-solid fa-lock"></i> Admin Login
                </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- Flash Messages Container -->
    <% if (typeof flash_messages !== 'undefined' && flash_messages.length > 0) { %>
        <div style="max-width: 1280px; margin: 20px auto 0; padding: 0 24px;">
            <% flash_messages.forEach(function(msg) { %>
                <div style="padding: 14px 20px; border-radius: 8px; margin-bottom: 12px; font-size: 0.95rem; font-weight: 500; display: flex; align-items: center; justify-content: space-between; <%= msg.type === 'success' ? 'background:#e6f4ea; color:#137333; border:1px solid #ceead6;' : (msg.type === 'danger' ? 'background:#fce8e6; color:#c5221f; border:1px solid #fad2cf;' : 'background:#e8f0fe; color:#1a73e8; border:1px solid #d2e3fc;') %>">
                    <span><%= msg.text %></span>
                    <button onclick="this.parentElement.remove()" style="background:none; border:none; cursor:pointer; font-size:1.1rem; color:inherit;">&times;</button>
                </div>
            <% }); %>
        </div>
    <% } %>

    <!-- Main Content -->
    <main>
