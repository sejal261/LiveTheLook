<%- include('../partials/header') %>

<div class="admin-layout">
    <!-- Admin Sidebar -->
    <aside class="admin-sidebar">
        <ul class="admin-menu">
            <li class="admin-menu-item">
                <a href="/admin" class="active">
                    <i class="fa-solid fa-gauge"></i> Overview
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="/admin/designs">
                    <i class="fa-solid fa-layer-group"></i> Manage Designs
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="/admin/design/add">
                    <i class="fa-solid fa-plus"></i> Add New Design
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="/admin/categories">
                    <i class="fa-solid fa-folder"></i> Categories
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="/admin/styles">
                    <i class="fa-solid fa-palette"></i> Styles
                </a>
            </li>
            <li class="admin-menu-item" style="margin-top:20px; border-top:1px solid #2C2A29; padding-top:12px;">
                <a href="/admin/logout" style="color:#e06c75;">
                    <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                </a>
            </li>
        </ul>
    </aside>

    <!-- Admin Main -->
    <main class="admin-main">
        <div class="admin-header">
            <div>
                <h1>Dashboard Overview</h1>
                <p style="color:#6E6A66;">Welcome back! Manage your room designs, product links, and categories.</p>
            </div>
            <a href="/admin/design/add" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Create Design
            </a>
        </div>

        <!-- Metrics Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Total Designs</h3>
                <div class="number"><%= total_designs %></div>
            </div>
            <div class="stat-card">
                <h3>Categories</h3>
                <div class="number"><%= total_categories %></div>
            </div>
            <div class="stat-card">
                <h3>Design Styles</h3>
                <div class="number"><%= total_styles %></div>
            </div>
            <div class="stat-card">
                <h3>Product Links</h3>
                <div class="number"><%= total_products %></div>
            </div>
        </div>

        <!-- Recent Designs Table -->
        <div class="admin-table-card">
            <div style="padding: 20px; border-bottom:1px solid #F3EFEA; display:flex; justify-content:space-between; align-items:center;">
                <h3 style="font-family:'Playfair Display', serif; font-size:1.3rem;">Recent Designs</h3>
                <a href="/admin/designs" class="btn btn-outline btn-sm">View All</a>
            </div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Style</th>
                            <th>Products</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recent_designs.forEach(function(design) { %>
                        <tr>
                            <td>
                                <img src="<%= design.image_url %>" alt="<%= design.title %>" style="width:48px; height:48px; object-fit:cover; border-radius:6px;">
                            </td>
                            <td style="font-weight:600;"><%= design.title %></td>
                            <td><%= design.category_name %></td>
                            <td><%= design.style_name %></td>
                            <td><%= design.products.length %> items</td>
                            <td>
                                <a href="/design/<%= design.id %>" target="_blank" class="btn btn-outline btn-sm" title="View Public"><i class="fa-solid fa-eye"></i></a>
                                <a href="/admin/design/edit/<%= design.id %>" class="btn btn-outline btn-sm" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
